# Ambiente: development | homolog | production
NODE_ENV=development
PORT=3333

# Aponte para bancos DIFERENTES em cada ambiente (nunca reutilize o
# banco de produção em homologação).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_livo_dev

# Lista separada por vírgula — a mesma API serve o app do cliente e o
# painel do restaurante, em origens diferentes.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Use as credenciais de TESTE do Mercado Pago em dev/homolog
# (https://www.mercadopago.com.br/developers/panel/app) e as de
# produção somente no ambiente de produção.
MERCADOPAGO_ACCESS_TOKEN=TEST-000000000000000-000000-00000000000000000000000000000000-000000000

# URL pública HTTPS deste backend, usada para o Mercado Pago chamar o
# webhook (em dev, use um túnel como ngrok/cloudflared).
PUBLIC_BASE_URL=http://localhost:3333

# Segredo usado para assinar o token de sessão do app do cliente.
# Gere um valor aleatório forte em homolog/produção (ex: openssl rand -hex 32).
JWT_SECRET=troque-este-valor-em-producao-0123456789

